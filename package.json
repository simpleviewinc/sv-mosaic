{
	"name": "sv-mosaic",
	"private": true,
	"description": "Mosaic UI Library monorepo",
	"author": "Owen Allen <owenallenaz@gmail.com>",
	"devDependencies": {
		"@stylistic/eslint-plugin": "1.6.0",
		"@types/node": "^20.14.2",
		"@typescript-eslint/eslint-plugin": "5.30.0",
		"@typescript-eslint/parser": "5.30.0",
		"eslint": "8.56.0",
		"eslint-plugin-react": "7.30.1",
		"eslint-plugin-react-hooks": "4.6.0",
		"ts-node": "^10.9.2",
		"typescript": "5.5.4"
	},
	"pnpm": {
		"overrides": {
			"prosemirror-model": "1.22.3",
			"react": "19.2.8",
			"react-dom": "19.2.8",
			"@types/react": "19.2.18",
			"@types/react-dom": "19.2.4"
		}
	},
	"scripts": {
		"release": "pnpm --filter @simpleview/sv-mosaic release",
		"host:dev": "pnpm --filter @simpleview/sv-mosaic build:esm && pnpm --parallel --filter \"./packages/{mosaic,storybook}\" start",
		"host:build": "pnpm --filter @simpleview/sv-mosaic build && pnpm --filter @simpleview/sv-mosaic-storybook build",
		"host:test:unit": "pnpm --filter @simpleview/sv-mosaic test",
		"host:test:consumer": "pnpm --filter @simpleview/sv-mosaic-consumer-tests types",
		"host:test:e2e": "pnpm --filter @simpleview/sv-mosaic build && pnpm --filter @simpleview/sv-mosaic-e2e test:chrome",
		"docker:dev": "docker compose up --build storybook-dev",
		"docker:lint": "docker compose up --build --exit-code-from lint lint",
		"docker:test:unit": "docker compose up --build --exit-code-from mosaic-units mosaic-units",
		"docker:test:consumer": "docker compose up --build --exit-code-from consumer-tests consumer-tests",
		"docker:test:e2e": "docker compose up --build --exit-code-from e2e-tests e2e-tests"
	},
	"packageManager": "pnpm@9.15.9",
	"repository": {
		"type": "git",
		"url": "https://github.com/simpleviewinc/sv-mosaic"
	},
	"license": "MIT"
}
